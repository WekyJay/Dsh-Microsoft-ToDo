{
  "name": "dsh-microsoft-todo",
  "version": "0.5.0",
  "type": "module",
  "description": "Microsoft To Do panel for DeepSeek Harness: browse lists, manage tasks, group lists, and keep a My Day short list — all from one pane.",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "microsoft-todo",
    "microsoft-graph",
    "todo",
    "tasks",
    "productivity"
  ],
  "author": "Weky Jay",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "dsh": ">=0.2.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WekyJay/Dsh-Microsoft-ToDo.git"
  },
  "homepage": "https://github.com/WekyJay/Dsh-Microsoft-ToDo#readme",
  "bugs": {
    "url": "https://github.com/WekyJay/Dsh-Microsoft-ToDo/issues"
  }
}
